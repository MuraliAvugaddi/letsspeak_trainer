<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer: no logo on the start screen, plain white -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFFFF</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- 📺 dark behind the class small window (no white flash) -->
        <item name="android:windowBackground">#FF0E2F48</item>
    </style>
</resources>
